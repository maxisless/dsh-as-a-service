.env
.venv/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store

# Runtime state and user-controlled workspace.
state/
workspace/

# Local model routes may contain private endpoint identifiers.
models.local.json

# Deployment-only provider configuration and credentials.
deploy/docker/.env
deploy/docker/models.json
deploy/docker/dsh-home/
deploy/docker/wheelhouse/*
!deploy/docker/wheelhouse/.gitkeep

# Private server-local Compose overrides are combined with the public Compose
# file at deployment time; they must never be committed.
deploy/docker/compose.private*.yml
