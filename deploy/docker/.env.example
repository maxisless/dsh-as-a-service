# Required by the default deepseek-official route.
DEEPSEEK_API_KEY=sk-your-key

# Optional provider base URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Worker tuning.
# DSH_HTTP_MAX_PARALLEL_SESSIONS=4
# DSH_RUNTIME_REQUEST_TIMEOUT_SECONDS=2400
#
# Optional hosted control-plane API. Keep this unset for the existing
# loopback-only /chat compatibility service. When set, /v1 endpoints require
# Authorization: Bearer <token> and persist tenant/Agent/session/run state.
# DSH_CONTROL_PLANE_TOKEN=replace-with-a-long-random-secret
# DSH_CONTROL_PLANE_TENANT=local
# DSH_CONTROL_PLANE_PRINCIPAL=local
# DSH_CONTROL_PLANE_ROLE=admin
# DSH_RUN_LEASE_SECONDS=300
#
# Optional multi-tenant token mapping. This is JSON text, normally injected
# by a secret manager rather than committed in an env file. When supplied it
# takes precedence over the single fallback token above.
# DSH_CONTROL_PLANE_IDENTITIES_JSON={"token-a":{"tenant_id":"tenant-a","principal_id":"admin-a","role":"admin"}}

# Optional compatible Debian/Ubuntu base image override for a network-restricted
# Docker host that already has a local image. The default is python:3.11-slim-bookworm.
# DSH_BASE_IMAGE=ubuntu-dev:v1
