# Required by the default deepseek-official route.
DEEPSEEK_API_KEY=sk-your-key

# Optional provider base URL.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Worker tuning.
# DSH_HTTP_MAX_PARALLEL_SESSIONS=4
# DSH_RUNTIME_REQUEST_TIMEOUT_SECONDS=2400

# Optional compatible Debian/Ubuntu base image override for a network-restricted
# Docker host that already has a local image. The default is python:3.11-slim-bookworm.
# DSH_BASE_IMAGE=ubuntu-dev:v1
